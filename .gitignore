# NexNotes — deny-all whitelist (keeps the GitHub repo clean)
/*

# ── allow project source ──
!/src/
!/prisma/
!/public/
!/docs/
!/scripts/
!/desktop/
!/desktop/src/
!/desktop/build/
/desktop/node_modules/
/desktop/dist/
!/.github/
!/tests/

# ── allow root config files ──
!/.gitignore
!/.dockerignore
!/.env.example
!/.npmrc
!/.gitleaksignore
!/package.json
!/bun.lock
!/next.config.ts
!/tsconfig.json
!/postcss.config.mjs
!/eslint.config.mjs
!/vitest.config.ts
!/playwright.config.ts
!/components.json
!/next-env.d.ts
!/README.md
!/LICENSE
!/.coderabbit.yaml
!/commitlint.config.mjs
!/release-please-config.json
!/.release-please-manifest.json
!/.husky/
/.husky/_/
!/SECURITY.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/PLAN.md
!/Dockerfile
!/docker-compose.yml

# ── inside allowed dirs, still block junk ──
**/.DS_Store
*.log
src/**/*.tsbuildinfo
tests/**/node_modules
test-results/
playwright-report/
coverage/

# legacy local experiments — never tracked (the shipped app is src/**/nexnotes
# + src/app/**; the nx/ tree is the pre-rewrite scaffold kept for reference)
/public/nex/
/public/nxicons/
/src/lib/nx/
/src/components/nx/
/src/app/api/nx/
/scripts/nx_icons.py
/scripts/nexnotes_icons.py
/scripts/nexnotes_postbuild.py
/scripts/probe-icons.mjs
/scripts/build-appimage.sh
/scripts/installer.nsi
/tests/*.sh
