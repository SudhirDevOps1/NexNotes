# NexNotes — environment configuration
# Copy to .env and adjust. NEVER commit your real .env.

# SQLite (default, zero-config):
DATABASE_URL="file:./db/custom.db"
# For Neon / Postgres run:  node scripts/db-switch.mjs postgres "postgresql://user:pass@host/db?sslmode=require"
# (that script rewrites prisma/schema.prisma and .env automatically)

# Session signing secret for JWT cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: direct (non-pooled) connection for migrations on Neon
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
